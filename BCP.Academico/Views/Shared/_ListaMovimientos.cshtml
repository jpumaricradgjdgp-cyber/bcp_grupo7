@model List<MovimientoItem>
@if (Model.Count == 0)
{
    <p class="bank-empty">No hay operaciones con esos filtros.</p>
}
else
{
    <ul class="bank-list">
        @foreach (var m in Model)
        {
            var yape = m.Canal == Canales.Yape;
            <li data-ref="@m.Referencia">
                @if (m.TieneConstancia && m.Referencia != null)
                {
                    <a href="/banca/constancia/@m.Referencia" class="bank-row">
                        <span class="bank-channel @(yape ? "purple" : "")">@Iconos.Svg(yape ? "pos" : "loan", 19)@m.Canal</span>
                        <span class="bank-row-desc"><strong>@m.Contraparte</strong><small>@m.Referencia · @Dinero.Fecha(m.FechaUtc)@(m.Tipo == TiposMovimiento.AjusteCompensatorio ? " · Ajuste" : "")</small></span>
                        <partial name="_EstadoOperacion" model="m.Estado" />
                        <strong class="bank-row-amount @(m.ImporteCentimos > 0 ? "abono" : "")">@Dinero.SolesConSigno(m.ImporteCentimos)</strong>
                    </a>
                }
                else
                {
                    <div class="bank-row">
                        <span class="bank-channel @(yape ? "purple" : "")">@Iconos.Svg(yape ? "pos" : "loan", 19)@m.Canal</span>
                        <span class="bank-row-desc"><strong>@(m.ImporteCentimos > 0 ? "De " : "")@m.Contraparte</strong><small>@m.Referencia · @Dinero.Fecha(m.FechaUtc) · @m.Tipo</small></span>
                        <partial name="_EstadoOperacion" model="m.Estado" />
                        <strong class="bank-row-amount @(m.ImporteCentimos > 0 ? "abono" : "")">@Dinero.SolesConSigno(m.ImporteCentimos)</strong>
                    </div>
                }
            </li>
        }
    </ul>
}
